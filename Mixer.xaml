<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#171817" BorderBrush="#4F504C" BorderThickness="1"
        TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.FontSize="16"
        TextElement.Foreground="#F1EFE9" UseLayoutRounding="True">
  <Border.Resources>
    <SolidColorBrush x:Key="Muted" Color="#B9B8AE"/>
    <SolidColorBrush x:Key="Amber" Color="#FFC15B"/>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F1EFE9"/>
      <Setter Property="Background" Value="#30312D"/>
      <Setter Property="BorderBrush" Value="#55564E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFC15B"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#FFC15B"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#121310"/><Setter Property="Foreground" Value="#F1EFE9"/>
      <Setter Property="BorderBrush" Value="#77786D"/><Setter Property="CaretBrush" Value="#FFC15B"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Padding" Value="8,3"/><Setter Property="MaxLength" Value="5"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1EFE9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="Foreground" Value="#FFC15B"/><Setter Property="Background" Value="#43443D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="Header" Background="#22231F" BorderBrush="#4F5048" BorderThickness="0,0,0,1" Padding="20,11,13,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Path Width="21" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" Stretch="Fill" Stroke="#FFC15B"
                StrokeThickness="1.5" Data="M 3,0 L 3,23 M 10,0 L 10,23 M 17,0 L 17,23 M 0,7 L 6,7 M 7,16 L 13,16 M 14,10 L 20,10"/>
          <TextBlock Text="Gary调音台" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="19,0,17,0">
          <TextBlock x:Name="Model" FontSize="19" Foreground="#DDDCD3" Text="正在读取显卡…" AutomationProperties.Name="显卡型号"/>
          <ComboBox x:Name="GpuList" FontSize="19" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="选择显卡"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="Startup" Content="启动设置" FontSize="19" Background="#252620" Margin="0,0,9,0"/>
          <Button x:Name="Minimize" Content="−" FontSize="19" MinWidth="36" Padding="6,4" Background="#22231F" BorderBrush="#22231F" AutomationProperties.Name="最小化到托盘"/>
          <Button x:Name="Hide" Content="×" FontSize="19" MinWidth="36" Padding="6,4" Background="#22231F" BorderBrush="#22231F" AutomationProperties.Name="关闭到托盘"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions>
          <Border Background="#1C1D19" BorderBrush="#4F5048" BorderThickness="0,0,1,0" Padding="22,17,20,19">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="显卡功率" FontSize="20" FontWeight="SemiBold"/>
              <Grid Grid.Row="1" Margin="0,10,0,15" MinHeight="252">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="59"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Canvas x:Name="Scale" Margin="0,13,0,13" ClipToBounds="False" IsHitTestVisible="False"/>
                <Slider x:Name="Fader" Grid.Column="1" Width="52" Orientation="Vertical" SmallChange="1" LargeChange="10"
                        IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" AutomationProperties.Name="功率上限，单位瓦">
                  <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                      <Grid Background="Transparent">
                        <Border Width="34" HorizontalAlignment="Center" Background="#11120F" BorderBrush="#525349" BorderThickness="1" CornerRadius="5"/>
                        <Border Width="6" HorizontalAlignment="Center" Margin="0,10" Background="#090A08" CornerRadius="3"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Stretch" Orientation="Vertical">
                          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb Width="49" Height="26" Cursor="SizeNS">
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Border CornerRadius="4" BorderThickness="1" BorderBrush="#EFBC65">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#FFD783"/><GradientStop Offset="1" Color="#CA8428"/></LinearGradientBrush></Border.Background>
                                    <StackPanel VerticalAlignment="Center"><Border Height="1" Background="#90601F" Margin="6,0,6,3"/><Border Height="1" Background="#90601F" Margin="6,0,6,3"/><Border Height="1" Background="#90601F" Margin="6,0"/></StackPanel>
                                  </Border>
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                        </Track>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Track" Property="Opacity" Value="0.42"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Slider.Template>
                </Slider>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                  <TextBlock Text="功率上限" Foreground="{StaticResource Muted}" FontSize="18"/>
                  <TextBlock x:Name="Power" Text="—" Foreground="{StaticResource Amber}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="53" TextWrapping="NoWrap"/>
                  <TextBlock x:Name="Range" Text="—" Foreground="{StaticResource Muted}" Margin="0,5,0,0" FontSize="14"/>
                </StackPanel>
              </Grid>
              <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                <Button x:Name="Preset350" Content="350 W" Margin="0,0,7,0"/>
                <Button x:Name="Preset450" Content="450 W" Margin="3,0"/>
                <Button x:Name="Preset550" Content="550 W" Margin="7,0,0,0"/>
              </UniformGrid>
            </Grid>
          </Border>
          <Grid Grid.Column="1" Margin="21,16,21,19">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="Meters"/>
            <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Bottom">
              <TextBox x:Name="Watt" Width="75" Height="40" AutomationProperties.Name="自定义瓦数"/>
              <TextBlock Text="W" Margin="8,0,12,0"/>
              <Button x:Name="Apply" Content="应用" Background="#FFC15B" Foreground="#231709" BorderBrush="#FFC15B" MinWidth="74" Margin="0,0,9,0"/>
              <Button x:Name="Restore" Content="恢复默认" MinWidth="101"/>
            </WrapPanel>
          </Grid>
        </Grid>
        <Border x:Name="StartupPanel" Visibility="Collapsed" Background="#252620" BorderBrush="#4F5048" BorderThickness="0,1,0,0" Padding="22,13">
          <StackPanel>
            <CheckBox x:Name="StartWindows" Content="登录 Windows 时启动到托盘" FontSize="19" Margin="0,0,0,9"/>
            <WrapPanel>
              <CheckBox x:Name="AutoPower" Content="启动时自动应用" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="AutoWatts" Width="74" Height="38" FontSize="19" AutomationProperties.Name="启动功率"/>
              <TextBlock Text="W" Margin="8,0,13,0"/>
              <Button x:Name="Save" Content="保存" FontSize="19"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#4F5048" BorderThickness="0,1,0,0" Background="#22231F" Padding="18,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" Text="正在连接 NVIDIA 驱动…" Margin="0,0,13,0" FontSize="14"/>
        <Button x:Name="Enable" Grid.Column="1" Content="启用免弹窗设置" Padding="10,4" MinHeight="31" FontSize="14"/>
      </Grid>
    </Border>
  </Grid>
</Border>
